{
  "name": "xmcrud",
  "version": "2.0.0",
  "description": "A lightweight helper library for building Express.js routes, controllers, advanced query with mongoose, and Redis-enhanced middleware with optional Redis support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "readmeFilename": "README.md",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xmcrud": "./dist/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "yarn clean && tsc && ts-node scripts/copyTemplates.ts",
    "dev": "ts-node src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "yarn build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --require ts-node/register/transpile-only --test \"test/**/*.test.ts\"",
    "test:watch": "node --require ts-node/register/transpile-only --test --watch \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "optimize-seo": "npm-seo-optimize"
  },
  "keywords": [
    "express",
    "middleware",
    "redis",
    "express-helper",
    "controller",
    "router",
    "express-router",
    "typescript",
    "rest",
    "api",
    "express-smart-helper",
    "crud",
    "xmcrud",
    "express helper",
    "crud",
    "mongoose-crud",
    "express-crud",
    "rest-crud",
    "rest-api-generator",
    "express-api",
    "express-crud-generator",
    "auto-crud",
    "crud-generator",
    "mongodb-crud"
  ],
  "author": "Suronjit Pal (suronjit797)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suronjit797/xmcrud.git"
  },
  "bugs": {
    "url": "https://github.com/suronjit797/xmcrud/issues"
  },
  "homepage": "https://github.com/suronjit797/xmcrud#readme",
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "ioredis": "^5.0.0",
    "mongoose": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^14.0.2",
    "fs-extra": "^11.3.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.1.0",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "mongoose": "^9.1.5",
    "npm-seo-optimizer": "^1.0.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
